# Copy to .env and fill in. Never commit .env.

# Database (local: docker compose up -d, or a local Postgres 16)
DATABASE_URL=postgres://wsg:wsg@localhost:5432/wsg

# Auth (Better Auth)
BETTER_AUTH_SECRET=change-me-to-32-plus-random-characters
BETTER_AUTH_URL=http://localhost:3000
# Enables email/password dev login. Refused when NODE_ENV=production.
DEV_LOGIN=1

# GitHub App (register at https://github.com/settings/apps/new)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=dev-webhook-secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Slack (optional; digest preview works without it)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# 32-byte key, base64. Encrypts stored Slack tokens (AES-256-GCM).
ENCRYPTION_KEY=
